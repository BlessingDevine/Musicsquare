<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Wednesday early check for New Music Friday: at 10:00 AM, a Mac notification + email ONLY if nothing is
  waiting for Friday yet (thursday-reminder.mjs --early). Thursday's reminder still runs as before.
  Switch on:
    cp scripts/catalog/wednesday-check.plist ~/Library/LaunchAgents/com.squaredrum.wednesday-check.plist
    launchctl load ~/Library/LaunchAgents/com.squaredrum.wednesday-check.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.squaredrum.wednesday-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/robertsimenya/Sites/musicsquareradio-2026/scripts/catalog/thursday-reminder.mjs</string>
    <string>--early</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/robertsimenya/Sites/musicsquareradio-2026</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>3</integer>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/robertsimenya/Library/Logs/squaredrum-wednesday-check.log</string>
  <key>StandardErrorPath</key><string>/Users/robertsimenya/Library/Logs/squaredrum-wednesday-check.log</string>
</dict>
</plist>
