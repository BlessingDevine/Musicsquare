# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.
# Values come from the Supabase dashboard: Project Settings -> API Keys.

# --- Used by the website (also add these three in Vercel -> Settings ->
# --- Environment Variables). Safe to be public: RLS limits them to released songs.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (sb_publishable_...), or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The CloudFront address the audio is served from, e.g. https://d1234abcd.cloudfront.net
NEXT_PUBLIC_AUDIO_BASE_URL=

# --- Used only by the importer on this Mac. NEVER add this one to Vercel.
# The "secret" key (sb_secret_...), or the legacy "service_role" key.
SUPABASE_SECRET_KEY=

# The S3 bucket the importer uploads to. AWS credentials are NOT stored here:
# the importer uses your `aws login` session.
AWS_REGION=us-west-1
AUDIO_BUCKET=
